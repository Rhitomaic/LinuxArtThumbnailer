def build_huff(bits, vals):
    """Build a {(length, code): symbol} lookup from a JPEG DHT."""
    table = {}
    code = 0
    idx = 0
    for length in range(1, 17):
        for _ in range(bits[length - 1]):
            if idx < len(vals):
                table[(length, code)] = vals[idx]
            idx += 1
            code += 1
        code <<= 1
    return table


DC0 = build_huff(DC0_BITS, DC0_VAL)
AC0 = build_huff(AC0_BITS, AC0_VAL)
DC1 = build_huff(DC1_BITS, DC1_VAL)
AC1 = build_huff(AC1_BITS, AC1_VAL)

# Precomputed IDCT matrix: out = IDCT_M @ freq @ IDCT_M.T
_iu = np.arange(8)
IDCT_M = np.zeros((8, 8), dtype=np.float64)
for y in range(8):
    for v in range(8):
        cv = 1.0 / np.sqrt(2.0) if v == 0 else 1.0
        IDCT_M[y, v] = 0.5 * cv * np.cos((2 * y + 1) * v * np.pi / 16.0)


class BitReader:
    """MSB-first bit reader with JPEG FF00 byte stuffing."""

    def __init__(self, data):
        self.data = data
        self.size = len(data)
        self.pos = 0
        self.bit = 0

    def read_bit(self):
        if self.pos >= self.size:
            return 0
        b = self.data[self.pos]
        v = (b >> (7 - self.bit)) & 1
        self.bit += 1
        if self.bit == 8:
            self.bit = 0
            self.pos += 1
            if b == 0xFF:
                self.pos += 1  # skip stuffed 0x00
        return v

    def read_bits(self, n):
        v = 0
        for _ in range(n):
            v = (v << 1) | self.read_bit()
        return v


def read_huff(reader, table):
    code = 0
    for length in range(1, 17):
        code = (code << 1) | reader.read_bit()
        sym = table.get((length, code))
        if sym is not None:
            return sym
    return -1


def decode_block(reader, dc_table, ac_table, prev_dc):
    """Decode one 8x8 block; returns (coeff[64] natural order, new prev_dc)."""
    coeff = np.zeros(64, dtype=np.float64)

    ssss = read_huff(reader, dc_table)
    if ssss <= 0:
        dc = prev_dc
    else:
        bits = reader.read_bits(ssss)
        if bits < (1 << (ssss - 1)):
            dc = prev_dc - ((1 << ssss) - 1 - bits)
        else:
            dc = prev_dc + bits
    prev_dc = dc
    coeff[0] = dc

    k = 1
    while k < 64:
        rs = read_huff(reader, ac_table)
        if rs < 0:
            break
        if rs == 0x00:
            break  # EOB
        rr = rs >> 4
        ss = rs & 0x0F
        if rr == 15 and ss == 0:
            k += 16  # ZRL
            continue
        k += rr
        if k >= 64:
            break
        bits = reader.read_bits(ss)
        if ss == 0:
            val = 0
        elif bits < (1 << (ss - 1)):
            val = bits - ((1 << ss) - 1)
        else:
            val = bits
        coeff[ZIGZAG[k]] = val
        k += 1

    return coeff, prev_dc


def find_segment(data, tag):
    """"Return the byte offset of a named segment, or -1."""
    n = struct.unpack_from("<I", data, 0x20)[0] if len(data) >= 0x24 else 0
    for i in range(n):
        off = 0x40 + i * 16
        if off + 16 > len(data):
            break
        if data[off:off + 4] == tag:
            return struct.unpack_from("<Q", data, off + 8)[0]
    # Fallback scan if the count is unreliable.
    off = 0x40
    while off + 16 <= len(data) and off < 0x400:
        if data[off:off + 4] == tag:
            return struct.unpack_from("<Q", data, off + 8)[0]
        off += 16
    return -1


def segment_end(data, seg_off):
    """End of a segment = next-higher segment offset, else end of file."""
    end = len(data)
    n = struct.unpack_from("<I", data, 0x20)[0] if len(data) >= 0x24 else 0
    for i in range(n):
        off = 0x40 + i * 16
        if off + 16 > len(data):
            break
        seg = struct.unpack_from("<Q", data, off + 8)[0]
        if seg_off < seg < end:
            end = seg
    return end


def decode_jssf(body):
    """Decode a jssf body (the contents of the 'thum' segment) to an RGB array."""
    if len(body) < 0x92 or body[8:12] != b"jssf":
        raise RuntimeError("jssf: bad header")

    width, height = struct.unpack_from("<II", body, 0)
    if width == 0 or height == 0 or width > 8192 or height > 8192:
        raise RuntimeError("jssf: bad dimensions")

    comps = struct.unpack_from("<H", body, 0x10)[0]
    if comps not in (1, 3):
        raise RuntimeError(f"jssf: unsupported component count {comps}")

    dqt = []
    dqt.append(np.frombuffer(body, dtype=np.uint8, count=64, offset=0x12).astype(np.float64))
    if comps > 1:
        dqt.append(np.frombuffer(body, dtype=np.uint8, count=64, offset=0x52).astype(np.float64))

    entropy = body[0x52 if comps == 1 else 0x92:]
    ent_size = len(entropy)

    dc_tables = [DC0, DC1, DC1]
    ac_tables = [AC0, AC1, AC1]
    qtables = [dqt[0], dqt[-1], dqt[-1]]

    nw = (width + 7) // 8
    nh = (height + 7) // 8

    planes = [np.zeros((height, width), dtype=np.float64) for _ in range(comps)]

    ep = 0
    for by in range(nh):
        if ep + 2 > ent_size:
            raise RuntimeError("jssf: truncated row header")
        (row_len,) = struct.unpack_from("<H", entropy, ep)
        ep += 2
        if ep + row_len > ent_size:
            raise RuntimeError("jssf: truncated row")
        row = entropy[ep:ep + row_len]
        ep += row_len

        reader = BitReader(row)
        prev_dc = [0, 0, 0]
        for bx in range(nw):
            for c in range(comps):
                coeff, prev_dc[c] = decode_block(reader, dc_tables[c], ac_tables[c], prev_dc[c])
                freq = (coeff * qtables[c]).reshape(8, 8)
                block = IDCT_M @ freq @ IDCT_M.T
                x0, y0 = bx * 8, by * 8
                x1, y1 = min(x0 + 8, width), min(y0 + 8, height)
                planes[c][y0:y1, x0:x1] = (block[:y1 - y0, :x1 - x0] + 128.0)

    y = planes[0]
    if comps > 1:
        cb = planes[1] - 128.0
        cr = planes[2] - 128.0
    else:
        cb = np.zeros_like(y)
        cr = np.zeros_like(y)

    r = y + 1.402 * cr
    g = y - 0.344136 * cb - 0.714136 * cr
    b = y + 1.772 * cb

    rgb = np.stack([r, g, b], axis=-1)
    return np.clip(np.round(rgb), 0, 255).astype(np.uint8)


def extract_thumbnail(input_path, output_path):
    data = input_path.read_bytes()
    if len(data) < 0x40 or data[:16] != b"SAI-CANVAS-TYPE0":
        raise RuntimeError("Not a valid .sai2 file")

    thum_off = find_segment(data, b"thum")
    if thum_off < 0 or thum_off + 8 >= len(data):
        raise RuntimeError("No 'thum' preview segment found in this .sai2 file")

    end = segment_end(data, thum_off)
    body = data[thum_off:end]

    rgb = decode_jssf(body)
    Image.fromarray(rgb, "RGB").save(output_path, format="PNG")


def main():
    if len(sys.argv) < 3:
        print("Usage: sai2-thumbnailer [input_file] [output_file]")
        sys.exit(1)
    input_file = Path(sys.argv[1])
    output_file = Path(sys.argv[2])
    try:
        extract_thumbnail(input_file, output_file)
    except Exception as e:
        print(f"Error generating thumbnail: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
